<div class="container mt-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @list.name %></h1>

    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
  </div>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">

          <%= image_tag bookmark.movie.poster_url, class: "card-img-top" %>

          <div class="card-body">
            <h5 class="card-title"><%= bookmark.movie.title %></h5>

            <p class="text-muted">
              ⭐ <%= bookmark.movie.rating %> / 10
            </p>

            <p class="card-text"><%= bookmark.movie.overview %></p>

            <p class="card-text">
              <small class="text-muted">
                "<%= bookmark.comment %>"
              </small>
            </p>

            <%= link_to "Delete",
                bookmark_path(bookmark),
                class: "btn btn-outline-danger btn-sm",
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>

        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to my lists", lists_path, class: "btn btn-outline-secondary mt-3" %>

</div>
