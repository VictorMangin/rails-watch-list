<div class="container mt-5">
  <h1>Create a new list</h1>

  <%= simple_form_for(@list) do |f| %>
    <%= f.input :name, placeholder: "e.g. My Favorites" %>
    <%= f.submit "Create list", class: "btn btn-primary" %>
  <% end %>

  <%= link_to "Back to my lists", lists_path, class: "btn btn-outline-secondary mt-3" %>
</div>
