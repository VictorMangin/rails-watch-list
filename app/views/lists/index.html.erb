<div class="container mt-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Movie Lists</h1>

    <%= link_to "Create a new list", new_list_path, class: "btn btn-primary" %>
  </div>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to list.name, list_path(list), class: "text-decoration-none text-dark" %>
            </h5>

            <p class="card-text text-muted">
              <%= pluralize(list.movies.count, "movie") %>
            </p>

            <%= link_to "View list", list_path(list), class: "btn btn-outline-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

</div>
